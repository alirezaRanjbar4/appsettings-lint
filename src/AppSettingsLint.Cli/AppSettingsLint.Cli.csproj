<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>appsettings-lint</ToolCommandName>
    <PackageId>AppSettingsLint.Tool</PackageId>
    <Version>0.2.0</Version>
    <Authors>alirezaRanjbar4</Authors>
    <Description>Catch duplicate keys, missing required settings, and unresolved placeholders in appsettings JSON before deployment.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/alirezaRanjbar4/appsettings-lint</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alirezaRanjbar4/appsettings-lint</PackageProjectUrl>
    <PackageTags>dotnet;configuration;appsettings;lint;cli</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AppSettingsLint.Core/AppSettingsLint.Core.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
